# Copy to .env.staging and replace every REPLACE_* value before starting staging.
STAGING_POSTGRES_USER=omnidesk_staging
STAGING_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
STAGING_POSTGRES_DB=omnidesk_staging
STAGING_POSTGRES_PORT=65432

STAGING_REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
STAGING_REDIS_PORT=16379

# Application connection values when API/worker run on the same host.
DATABASE_URL=postgresql://omnidesk_staging:REPLACE_WITH_URL_ENCODED_POSTGRES_PASSWORD@localhost:65432/omnidesk_staging?schema=public
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD

# Shared application database limits (local/staging, per process/session).
API_DB_POOL_SIZE=5
WORKER_DB_POOL_SIZE=5
DB_POOL_TIMEOUT_SECONDS=5
DB_TRANSACTION_MAX_WAIT_MS=2000
DB_TRANSACTION_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=1000
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
# Optional INSTANCE_ID; defaults to hostname/local and labels pg_stat_activity.
WORKER_INBOUND_CONCURRENCY=2
WORKER_OUTBOUND_CONCURRENCY=2
WORKER_EMAIL_SYNC_CONCURRENCY=1
WORKER_EMAIL_ACTIONS_CONCURRENCY=1
WORKER_SLA_CHECK_CONCURRENCY=1
WORKER_AUTO_CLOSE_CONCURRENCY=1
WORKER_ANALYTICS_CONCURRENCY=1
WORKER_MAINTENANCE_BATCH_SIZE=100
