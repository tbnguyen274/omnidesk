{
  "name": "omnidesk",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:worker": "pnpm --filter worker start:dev",
    "dev:ngrok": "node --experimental-strip-types scripts/dev-ngrok.mts",
    "docker:up": "docker compose --env-file .env.docker up --build -d",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f",
    "docker:migrate": "docker compose --env-file .env.docker run --rm migrate",
    "docker:seed": "docker compose --env-file .env.docker run --rm seed",
    "staging:config": "docker compose -f docker-compose.staging.yml --env-file .env.staging config --quiet",
    "staging:up": "docker compose -f docker-compose.staging.yml --env-file .env.staging up -d postgres redis",
    "staging:down": "docker compose -f docker-compose.staging.yml --env-file .env.staging down",
    "staging:backup": "docker compose -f docker-compose.staging.yml --env-file .env.staging run --rm backup",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:up": "docker compose --env-file .env.docker up -d postgres redis",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:reconcile-tickets": "pnpm --filter api prisma:reconcile-tickets",
    "db:reset": "pnpm --filter api exec prisma migrate reset --force",
    "db:seed": "pnpm --filter api prisma:seed",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck:backend": "pnpm --filter @omnidesk/shared build && pnpm --filter @omnidesk/domain build && pnpm -r --filter api --filter worker --filter @omnidesk/shared --filter @omnidesk/domain typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:inspect": "pnpm --filter @omnidesk/shared build && node --experimental-strip-types scripts/database-operations.mts inspect",
    "db:budget": "pnpm --filter @omnidesk/shared build && node --experimental-strip-types scripts/database-operations.mts budget",
    "db:check-migrations": "node --experimental-strip-types scripts/check-migrations.mts",
    "db:test-compatibility": "node --experimental-strip-types scripts/schema-compatibility.mts",
    "test:governance": "node --experimental-strip-types --test scripts/test/*.test.mts",
    "db:test-load": "node --experimental-strip-types scripts/database-load.mts",
    "typecheck:tooling": "pnpm --filter @omnidesk/shared build && pnpm --filter @omnidesk/domain build && pnpm --filter worker exec tsc -p ../../scripts/tsconfig.json",
    "generate:secret": "node --experimental-strip-types scripts/generate-secret.mts"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  },
  "packageManager": "pnpm@11.8.0"
}
